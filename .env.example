# Compatibilita per importare token da versioni precedenti.
# Preferire Impostazioni o Token GLPI: salvano direttamente con Windows DPAPI.
# Eventuali token nel .env sono in chiaro fino alla prima lettura GLPI riuscita.
# Dopo verifica del file cifrato, l’app rimuove le righe dei token. Il .env e escluso da Git.
GLPI_USER_TOKEN=
GLPI_APP_TOKEN=
